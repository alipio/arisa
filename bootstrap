#!/usr/bin/env bash

set -Eeo pipefail

c_red=$'\e[1;31;1m'
c_green=$'\e[1;32;1m'
c_yellow=$'\e[1;33;1m'
c_blue=$'\e[1;34;1m'
c_magenta=$'\e[1;35;1m'
c_cyan=$'\e[1;36;1m'
c_white=$'\e[1;37;1m'
c_reset=$'\e[0m'

log() {
  local message=$1
  local pre_message="${2-\n\n}"
  printf "%b%b>> %b%b\n\n" "$pre_message" "$c_cyan" "$message" "$c_reset"
}

die() {
  local message=$1
  printf "%bERROR: %b%b\n" "$c_red" "$message" "$c_reset" >&2
  exit 1
}

trap 'die "Bootstrap failed at line $LINENO ($?)"' ERR

if [[ ! -f /etc/arch-release ]]; then
  die "This script is designed for vanilla Arch"
fi

if ((EUID == 0)); then
  die "This script is not meant to be run as root"
fi

cat <<EOF

${c_yellow}[*] Starting ARISA bootstrap... Go grab some coffee, this can take a
while!${c_reset}
EOF
sleep 3

tmpdir=$(mktemp -d arisa.XXXXXX) || die "Failed to create temp directory"
trap 'rm -rf "$tmpdir"' EXIT

log "Checking if sudo works"
if ! sudo -Nnv 2>/dev/null; then
  sudo -v || die "It appears that you don't have sudo privileges"
fi

cd "$(dirname "${BASH_SOURCE[0]}")"
sudo cp ./assets/pacman.conf /etc/pacman.conf
# shellcheck disable=SC2046
sudo sed -i 's/^#\?MAKEFLAGS=.*/MAKEFLAGS="-j'$(nproc)'"/' /etc/makepkg.conf

log "Upgrading system"
sudo pacman -Sy --noconfirm --needed archlinux-keyring
sudo pacman -Su --noconfirm

log "Installing critical dependencies"
sudo pacman -S --noconfirm --needed git base-devel wget unzip jq

if ! command -v yay >/dev/null; then
  git clone -q --depth 1 https://aur.archlinux.org/yay-bin.git "$tmpdir/yay-bin"
  (cd "$tmpdir/yay-bin" && makepkg -si --noconfirm) || die "Failed to install yay"
fi

log "Installing core packages"
mapfile -t pkgs < <(grep -Ev '^#|^\s*$' ./assets/packagelist)
sudo pacman -S --needed --noconfirm "${pkgs[@]}"

mapfile -t aurpkgs < <(grep -Ev '^#|^\s*$' ./assets/aurlist)
yay -S --needed --noconfirm "${aurpkgs[@]}"

log "Enabling system services"
sudo systemctl -q enable keyd.service

log "Installing GTK theme"
dir="$tmpdir"/tokyonight-gtk
git clone -q --depth 1 https://github.com/Fausto-Korpsvart/Tokyonight-GTK-Theme.git "$dir"
mkdir -p ~/.{themes,icons}
(
  cd "$dir/themes" || exit 1
  ./install.sh --color dark --tweaks storm --libadwaita
  sed -i -e 's/oomox-//' ../icons/*/index.theme
  cp -a ../icons/Tokyonight-Dark-Cyan ~/.icons
  gtk-update-icon-cache -ft ~/.icons/Tokyonight-Dark-Cyan 2>/dev/null || true
) || die "Theme installation failed."

log "Installing my beloved dotfiles"
mkdir -p ~/.{config,cache} \
  ~/.local/share \
  ~/{dl,docs,music,img,videos,dev}
rm -f ~/.bashrc ~/.bash_{history,profile,logout}
rm -f ~/.viminfo
./install

log "Setting up Github SSH key"
if ! command -v bw >/dev/null; then
  wget --no-hsts -qO "$tmpdir/bw.zip" "https://bitwarden.com/download/?app=cli&platform=linux"
  sudo unzip -q "$tmpdir/bw.zip" bw -d /usr/local/bin
  sudo chmod +x /usr/local/bin/bw
fi
if ! bw login --check >/dev/null 2>&1; then
  printf "%b%b%b\n" "$c_green" "Please log in to Bitwarden" "$c_reset"
  BW_SESSION=$(bw login --raw) || die "Failed to log in to Bitwarden"
  export BW_SESSION
elif ! bw unlock --check >/dev/null 2>&1; then
  printf "%b%b%b\n" "$c_green" "Please unlock your Bitwarden vault" "$c_reset"
  BW_SESSION=$(bw unlock --raw) || die "Failed to unlock Bitwarden vault"
  export BW_SESSION
fi
bw sync --force
mkdir -p ~/.ssh
bw get item gh_ssh_key | jq -r .sshKey.privateKey > ~/.ssh/id_ed25519
for host in github.com gitlab.com; do
  ssh-keygen -F "$host" >/dev/null || ssh-keyscan -H "$host" >> ~/.ssh/known_hosts
done
[ -f ~/.ssh/config ] || touch ~/.ssh/config
grep -Fqx "AddKeysToAgent yes" ~/.ssh/config || echo "AddKeysToAgent yes" >> ~/.ssh/config
chmod 700 ~/.ssh
chmod 600 ~/.ssh/id_ed25519 ~/.ssh/config
chmod 644 ~/.ssh/known_hosts

if command -v asdf >/dev/null; then
  log "Installing the latest Ruby version via asdf"
  if asdf plugin-list | grep -Fq ruby; then
    asdf plugin update ruby
  else
    asdf plugin add ruby
  fi
  ruby_latest=$(asdf latest ruby)
  if ! asdf list ruby | grep -Fq "$ruby_latest"; then
    asdf install ruby "$ruby_latest"
    asdf set -u ruby "$ruby_latest"
    asdf reshim ruby
  fi
  gem update --system || true
  [ -f ~/.gemrc ] || touch ~/.gemrc
  grep -Fqx "gem: --no-document" ~/.gemrc || echo "gem: --no-document" >> ~/.gemrc
  bundle config --global jobs "$(nproc)" >/dev/null 2>&1 || true
fi

cat <<EOF

${c_yellow}Bootstrap complete! You may need to restart your computer for all changes to take
effect.

Have fun! :)${c_reset}
EOF
