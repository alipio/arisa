# ~/.gitconfig
[user]
  name = Alípio de Paula
  email = alipiodepaula@gmail.com

[alias]
  amend = !git commit --amend -v --date="$(date +%Y-%m-%dT%H:%M:%S)"
  branches = branch -a
  discard = checkout --
  go = !"f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"
  master = checkout master
  pick = cherry-pick
  forsake = !git reset --hard HEAD && git clean -df
  recommit = commit -a --amend --no-edit
  refresh = pull --rebase --autostash origin HEAD
  uncommit = reset --soft HEAD~1
  unstage = reset HEAD --

[branch]
  sort = -committerdate

[color]
  ui = true

[color "diff"]
  meta = 11
  frag = magenta bold
  func = 146 bold
  old = red bold
  new = green bold
  commit = yellow bold
  whitespace = red reverse

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22

[commit]
  verbose = true

[core]
  autocrlf = input
  excludesFile = ~/.gitignore_global
  pager = diff-so-fancy | less --tabs=4 -RF
  # Speed up commands involving untracked files such as `git status`.
  # https://git-scm.com/docs/git-update-index#_untracked_cache
  untrackedCache = true

[diff]
  algorithm = histogram
  submodule = log

[fetch]
  prune = true
  pruneTags = true

[help]
  # Automatically correct and execute mistyped commands
  autoCorrect = immediate

[init]
  defaultBranch = master

[interactive]
  diffFilter = diff-so-fancy --patch

[log]
  abbrevCommit = true
  date = iso

[merge]
  conflictStyle = zdiff3

[pull]
  rebase = true

[push]
  default = current
  autoSetupRemote = true

[rebase]
  autoStash = true

[rerere]
  enabled = true

[status]
  short = true
  submoduleSummary = true

[tag]
  sort = version:refname

[url "git@github.com:"]
  pushInsteadOf = https://github.com/
